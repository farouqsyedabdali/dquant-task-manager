generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  passwordHash      String?
  googleId          String?            @unique
  authProvider      String             @default("email")
  subscriptionPlan  String             @default("free")
  autoArchivePeriod Int?               // Months after due date to auto-archive (3, 6, 9, 12)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  markedForDeletion Boolean            @default(false)
  isPersonal        Boolean            @default(false)
  auditLogs         AuditLog[]
  comments          Comment[]
  notifications     Notification[]
  projects          Project[]
  projectTemplates  ProjectTemplate[]
  tasks             Task[]
  coAssignees       TaskCoAssignee[]
  taskCollaborators TaskCollaborator[]
  taskShares        TaskShare[]
  users             User[]
}

model User {
  id                       Int                @id @default(autoincrement())
  name                     String
  email                    String
  password                 String?
  googleId                 String?             @unique
  authProvider             String              @default("email")
  role                     Role                @default(EMPLOYEE)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  companyId                Int
  department               String             @default("Default Department")
  position                 String             @default("Default Position")
  emailVerificationCode    String?
  emailVerificationExpires DateTime?
  isEmailVerified          Boolean            @default(false)
  invitationToken          String?
  invitationExpires        DateTime?
  invitationSentAt         DateTime?
  failedLoginAttempts      Int                  @default(0)
  accountLockedUntil       DateTime?
  lastLoginAttempt         DateTime?
  auditLogs                AuditLog[]
  comments                 Comment[]
  contacts                 Contact[]
  notifications            Notification[]
  assignedTasks            Task[]             @relation("AssignedTasks")
  createdTasks             Task[]             @relation("CreatedTasks")
  coAssignedTasks          TaskCoAssignee[]
  collaboratedTasks        TaskCollaborator[]
  receivedTaskInvitations  TaskInvitation[]   @relation("ReceivedInvitations")
  sentTaskInvitations      TaskInvitation[]   @relation("SentInvitations")
  sharedTasks              TaskShare[]
  ownedProjects            Project[]          @relation("OwnedProjects")
  projectMemberships       ProjectMember[]
  projectTemplates         ProjectTemplate[]
  templateTasks            TemplateTask[]
  company                  Company            @relation(fields: [companyId], references: [id])

  @@unique([email, companyId])
}

model Task {
  id                    Int                @id @default(autoincrement())
  title                 String
  description           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  status                TaskStatus         @default(TODO)
  priority              Priority           @default(MEDIUM)
  companyId             Int
  assigneeId            Int?
  assignerId            Int
  parentTaskId          Int?
  projectId             Int?
  dueDate               DateTime?
  statusManuallyChanged Boolean            @default(false)
  archived              Boolean            @default(false)
  externalContactId     Int?
  isDraft               Boolean            @default(false)
  sentAt                DateTime?
  declinedReason        String?
  comments              Comment[]
  notifications         Notification[]
  reminders             TaskReminder[]
  assignee              User?              @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigner              User               @relation("CreatedTasks", fields: [assignerId], references: [id])
  company               Company            @relation(fields: [companyId], references: [id])
  externalContact       Contact?           @relation("AssignedTasks", fields: [externalContactId], references: [id])
  parentTask            Task?              @relation("SubTasks", fields: [parentTaskId], references: [id])
  subtasks              Task[]             @relation("SubTasks")
  project               Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coAssignees           TaskCoAssignee[]
  collaborators         TaskCollaborator[]
  invitations           TaskInvitation[]
  sharedWith            TaskShare[]

  @@index([projectId])
  @@index([isDraft])
}

model Project {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  color       String           @default("#6366f1")
  icon        String           @default("📁")
  template    String?
  status      ProjectStatus    @default(ACTIVE)
  ownerId     Int
  companyId   Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  dueDate     DateTime?
  owner       User             @relation("OwnedProjects", fields: [ownerId], references: [id])
  company     Company          @relation(fields: [companyId], references: [id])
  tasks       Task[]
  members     ProjectMember[]

  @@index([companyId])
  @@index([ownerId])
}

model ProjectMember {
  id        Int             @id @default(autoincrement())
  projectId Int
  userId    Int
  role      ProjectRole     @default(MEMBER)
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectTemplate {
  id              Int            @id @default(autoincrement())
  name            String
  description     String?
  color           String         @default("#6366f1")
  icon            String         @default("📁")
  userId          Int
  companyId       Int
  isPersonal      Boolean        @default(true)
  category        TemplateCategory @default(PROFESSIONAL)
  isSystemTemplate Boolean        @default(false)
  tags            String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now())
  lastUsedAt      DateTime?
  usageCount      Int            @default(0)
  tasks           TemplateTask[]
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company        @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([category, isSystemTemplate])
  @@index([tags])
}

model TemplateTask {
  id                Int              @id @default(autoincrement())
  templateId        Int
  title             String
  description       String?
  priority          Priority         @default(MEDIUM)
  assigneeId        Int?
  externalContactId Int?
  daysOffset        Int              @default(0)
  order             Int              @default(0)
  template          ProjectTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignee          User?            @relation(fields: [assigneeId], references: [id])
  externalContact   Contact?         @relation(fields: [externalContactId], references: [id])

  @@index([templateId])
  @@index([assigneeId])
  @@index([externalContactId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  taskId    Int
  authorId  Int
  createdAt DateTime  @default(now())
  companyId Int
  editedAt  DateTime?
  author    User      @relation(fields: [authorId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  taskId    Int
  userId    Int
  companyId Int
  createdAt DateTime         @default(now())
  company   Company          @relation(fields: [companyId], references: [id])
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskCoAssignee {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  companyId Int
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskShare {
  id              Int      @id @default(autoincrement())
  taskId          Int
  userId          Int?
  contactId       Int?
  email           String?
  companyId       Int
  permissionLevel String   @default("VIEWER")
  isExternal      Boolean  @default(false)
  token           String?  @unique @default(uuid())
  createdAt       DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id])
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@unique([taskId, contactId])
  @@unique([taskId, email])
}

model TaskCollaborator {
  id              Int      @id @default(autoincrement())
  taskId          Int
  userId          Int
  companyId       Int
  permissionLevel String   @default("VIEW")
  isExternal      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id])
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskInvitation {
  id              String           @id @default(cuid())
  token           String           @unique @default(uuid())
  taskId          Int
  senderId        Int
  recipientEmail  String
  recipientUserId Int?
  status          InvitationStatus @default(PENDING)
  message         String?
  createdAt       DateTime         @default(now())
  expiresAt       DateTime?
  respondedAt     DateTime?
  recipient       User?            @relation("ReceivedInvitations", fields: [recipientUserId], references: [id])
  sender          User             @relation("SentInvitations", fields: [senderId], references: [id])
  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([recipientEmail])
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  action      AuditAction
  entityType  String
  entityId    Int?
  description String
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  userId      Int
  companyId   Int
  createdAt   DateTime    @default(now())
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Contact {
  id            Int         @id @default(autoincrement())
  userId        Int
  name          String
  email         String
  company       String?
  phone         String?
  isPersonal    Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]         @relation("AssignedTasks")
  sharedTasks   TaskShare[]
  templateTasks TemplateTask[]

  @@unique([userId, email])
  @@index([userId, email])
}

model TaskReminder {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  sentAt    DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([sentAt])
}

enum Role {
  SYSDMIN
  ADMIN
  EMPLOYEE
  SUPER_ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  UNACCEPTED
}

enum NotificationType {
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_ASSIGNED
  TASK_DUE_SOON
  COMMENT_ADDED
  SUBTASK_ADDED
  TASK_COMPLETED
  TASK_SHARED
  TASK_ARCHIVED
  TASK_UNARCHIVED
  TASK_INVITATION_RECEIVED
  TASK_INVITATION_ACCEPTED
  TASK_INVITATION_DECLINED
  TASK_INVITATION_UNACCEPTED
  PROJECT_TASK_SENT
  PROJECT_TASK_ACCEPTED
  PROJECT_TASK_DECLINED
  PROJECT_TASK_REASSIGNED
}

enum AuditAction {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_UNACCEPTED
  TASK_DUE_DATE_CHANGED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  CO_ASSIGNEE_ADDED
  CO_ASSIGNEE_REMOVED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_ROLE_CHANGED
  COMPANY_UPDATED
  COMPANY_DELETED
  USER_LOGIN
  USER_LOGOUT
  PASSWORD_CHANGED
  SYSTEM_ACTION
  TASK_SHARED
  TASK_UNSHARED
  TASK_ARCHIVED
  TASK_UNARCHIVED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  TASK_ADDED_TO_PROJECT
  TASK_REMOVED_FROM_PROJECT
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  PROJECT_CREATED_FROM_TEMPLATE
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TemplateCategory {
  PERSONAL
  PROFESSIONAL
}
