generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String
  subscriptionPlan String    @default("free")
  markedForDeletion Boolean  @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[]
  tasks            Task[]
  comments         Comment[]
  notifications    Notification[]
  coAssignees      TaskCoAssignee[]
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String
  password      String
  role          Role      @default(EMPLOYEE)
  companyId     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id])
  comments      Comment[]
  notifications Notification[]
  coAssignedTasks TaskCoAssignee[] // Tasks where this user is a co-assignee
  
  // Task relationships
  assignedTasks Task[]    @relation("AssignedTasks")     // Tasks assigned to this user
  createdTasks  Task[]    @relation("CreatedTasks")      // Tasks created by this user
  
  @@unique([email, companyId])
}

model Task {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  
  // Task assignment and hierarchy
  assignerId   Int        // Who created/assigned the task
  assigneeId   Int        // Who the task is assigned to (lead assignee)
  parentTaskId Int?       // For subtasks (optional)
  
  // Metadata
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?  // Optional due date for tasks
  companyId    Int
  
  // Relations
  comments     Comment[]
  notifications Notification[]
  coAssignees  TaskCoAssignee[] // Co-assignees for this task
  assigner     User       @relation("CreatedTasks", fields: [assignerId], references: [id])
  assignee     User       @relation("AssignedTasks", fields: [assigneeId], references: [id])
  parentTask   Task?      @relation("SubTasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]     @relation("SubTasks")
  company      Company    @relation(fields: [companyId], references: [id])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  taskId    Int
  authorId  Int
  companyId Int
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id])
}

model Notification {
  id          Int              @id @default(autoincrement())
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  taskId      Int
  userId      Int              // User who should receive this notification
  companyId   Int
  createdAt   DateTime         @default(now())
  
  // Relations
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company          @relation(fields: [companyId], references: [id])
}

enum Role {
  SYSDMIN
  ADMIN
  EMPLOYEE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskCoAssignee {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int      // Co-assignee user
  companyId Int
  createdAt DateTime @default(now())
  
  // Relations
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id])
  
  @@unique([taskId, userId]) // Prevent duplicate co-assignees for same task
}

enum NotificationType {
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_ASSIGNED
  TASK_DUE_SOON
  COMMENT_ADDED
  SUBTASK_ADDED
  TASK_COMPLETED
}
