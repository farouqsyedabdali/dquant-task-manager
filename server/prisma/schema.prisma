generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String?
  subscriptionPlan String    @default("free")
  markedForDeletion Boolean  @default(false)
  isPersonal       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[]
  tasks            Task[]
  comments         Comment[]
  notifications    Notification[]
  coAssignees      TaskCoAssignee[]
  taskShares       TaskShare[]
  auditLogs        AuditLog[]
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String
  password      String
  role          Role      @default(EMPLOYEE)
  companyId     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id])
  comments      Comment[]
  notifications Notification[]
  coAssignedTasks TaskCoAssignee[] // Tasks where this user is a co-assignee
  auditLogs     AuditLog[] // Actions performed by this user
  
  // Task relationships
  assignedTasks Task[]    @relation("AssignedTasks")     // Tasks assigned to this user
  createdTasks  Task[]    @relation("CreatedTasks")      // Tasks created by this user
  sharedTasks   TaskShare[] // Tasks shared with this user
  
  @@unique([email, companyId])
}

model Task {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  
  // Task assignment and hierarchy
  assignerId   Int        // Who created/assigned the task
  assigneeId   Int        // Who the task is assigned to (lead assignee)
  parentTaskId Int?       // For subtasks (optional)
  
  // Metadata
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?  // Optional due date for tasks
  companyId    Int
  
  // Auto-status management
  statusManuallyChanged Boolean @default(false) // Track if status was manually changed by creator
  
  // Archive management
  archived Boolean @default(false) // Whether task is archived
  
  // Relations
  comments     Comment[]
  notifications Notification[]
  coAssignees  TaskCoAssignee[] // Co-assignees for this task
  sharedWith   TaskShare[] // Users this task is shared with
  assigner     User       @relation("CreatedTasks", fields: [assignerId], references: [id])
  assignee     User       @relation("AssignedTasks", fields: [assigneeId], references: [id])
  parentTask   Task?      @relation("SubTasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]     @relation("SubTasks")
  company      Company    @relation(fields: [companyId], references: [id])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  taskId    Int
  authorId  Int
  companyId Int
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  author    User      @relation(fields: [authorId], references: [id])
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id])
}

model Notification {
  id          Int              @id @default(autoincrement())
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  taskId      Int
  userId      Int              // User who should receive this notification
  companyId   Int
  createdAt   DateTime         @default(now())
  
  // Relations
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company          @relation(fields: [companyId], references: [id])
}

enum Role {
  SYSDMIN
  ADMIN
  EMPLOYEE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskCoAssignee {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int      // Co-assignee user
  companyId Int
  createdAt DateTime @default(now())

  // Relations
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([taskId, userId]) // Prevent duplicate co-assignees for same task
}

model TaskShare {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int      // User the task is shared with
  companyId Int
  createdAt DateTime @default(now())

  // Relations
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([taskId, userId]) // Prevent duplicate shares for same task and user
}

enum NotificationType {
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_ASSIGNED
  TASK_DUE_SOON
  COMMENT_ADDED
  SUBTASK_ADDED
  TASK_COMPLETED
  TASK_SHARED
  TASK_ARCHIVED
  TASK_UNARCHIVED
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  action      AuditAction
  entityType  String      // e.g., "Task", "Comment", "User", "CoAssignee"
  entityId    Int?        // ID of the affected entity (null for some actions)
  description String      // Human-readable description of the action
  oldValues   Json?       // Previous values (for updates)
  newValues   Json?       // New values (for creates/updates)
  metadata    Json?       // Additional context (e.g., task title, comment content)
  
  // Who performed the action
  userId      Int
  companyId   Int
  createdAt   DateTime    @default(now())
  
  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

enum AuditAction {
  // Task actions
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_DUE_DATE_CHANGED
  
  // Comment actions
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  
  // Co-assignee actions
  CO_ASSIGNEE_ADDED
  CO_ASSIGNEE_REMOVED
  
  // User actions
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_ROLE_CHANGED
  
  // Company actions
  COMPANY_UPDATED
  COMPANY_DELETED
  
  // Authentication actions
  USER_LOGIN
  USER_LOGOUT
  PASSWORD_CHANGED
  
  // System actions
  SYSTEM_ACTION
  // Task sharing actions
  TASK_SHARED
  TASK_UNSHARED
  // Task archive actions
  TASK_ARCHIVED
  TASK_UNARCHIVED
}
