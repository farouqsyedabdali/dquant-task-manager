# Database
DATABASE_URL="postgresql://username:password@localhost:5432/company_name_task_manager"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3000
NODE_ENV=production

# Client URL for CORS (will be your Vercel URL)
CLIENT_URL="https://your-app.vercel.app"

# OpenRouter API (for AI features)
OPENROUTER_API_KEY="your-openrouter-api-key"

# Resend API (for email features)
RESEND_API_KEY="re_your_resend_api_key_here"

# Email Configuration
EMAIL_FROM="onboarding@resend.dev"  # Or your custom domain email
FRONTEND_URL="https://your-app.vercel.app"  # For email links

