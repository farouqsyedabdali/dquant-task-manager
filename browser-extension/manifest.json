{
  "manifest_version": 3,
  "name": "Send to AI Assistant",
  "version": "1.0",
  "description": "Send highlighted text to your AI assistant for task creation, summarization, or explanation.",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "48": "icon48.png"
  }
} 